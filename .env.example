# --- Portal credentials (used by the adapter's login step) ---
BOT_USERNAME=
BOT_PASSWORD=

# --- Proxy (optional; leave empty to use your own IP) ---
# Residential / mobile proxy, e.g. http://user:pass@host:port or socks5://host:port
BOT_PROXY_URL=

# --- Telegram notifications + remote OTP entry ---
# Create a bot with @BotFather, then get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- CAPTCHA solver (interface is built; add a provider key when you enable one) ---
SOLVER_PROVIDER=manual
SOLVER_API_KEY=

# --- Targeting ---
TARGET_ADAPTER=reference
TARGET_DATE_FROM=
TARGET_DATE_TO=
TARGET_WEEKDAYS=

# --- Misc ---
LOG_LEVEL=info
HEADLESS=true

# Optional: a pre-fetched one-time code (e.g. from an SMS-forwarding hook).
# Leave empty to be prompted on the terminal / Telegram instead.
OTP_CODE=
