{
  "name": "booking-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Portal-agnostic web booking & slot monitoring bot (Playwright + TypeScript)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "doctor": "tsx src/cli.ts doctor",
    "monitor": "tsx src/cli.ts monitor",
    "run:bot": "tsx src/cli.ts run",
    "demo": "tsx demo/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "pino": "^9.5.0",
    "playwright": "^1.49.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
